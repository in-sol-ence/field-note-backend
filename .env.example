# Copy this file to .env and fill in the keys.
#
# Fully live (real T0 dossier + live T1 scrapes): all three keys below are
# required. Demo mode (./run.sh --demo) does not need them — see
# notes-gregory.md §11 and README "Fully live".

# xAI. Shared with models/grok.py, which reads XAI_API_KEY directly.
XAI_API_KEY=xai-your-api-key-here

# T0 scraping. Both have free tiers.
FIRECRAWL_API_KEY=fc-...
EXA_API_KEY=...

# T0 synthesis defaults to xAI / grok-4.6. Uncomment to borrow any
# OpenAI-compatible gateway instead — delete both lines to put Grok back.
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.6

# X scrape provider for POST /scrape/x (x-scraper | social-signals | fixture)
# x-scraper is a Playwright PUPPET, not an official X client. Replace it with
# a real X API key + API client for anything durable.
# X_SCRAPE_PROVIDER=x-scraper
# Defaults to the ./x-scraper git submodule after: git submodule update --init
# X_SCRAPER_ROOT=/absolute/path/to/x-scraper
# X_SCRAPER_PYTHON=/absolute/path/to/x-scraper/.venv/bin/python
# X_SCRAPE_FIXTURE=data/signals_openclaw_x.json

# T1 Reddit/HN via social-signals on :8899. Prefer the PRIVATE social-signals
# repo. social_signals_lite in this repo is a temporary :8899 stand-in only.
# Optional: with no scraper reachable the run falls back to recorded signals
# in scraping/data/ and says so. Not checked at startup for that reason.
# SOCIAL_SIGNALS_URL=http://127.0.0.1:8899
# SOCIAL_SIGNALS_API_KEY=demo-key
