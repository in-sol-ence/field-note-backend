# Copy this file to .env and fill in the keys.

# xAI. Shared with models/grok.py, which reads XAI_API_KEY directly.
XAI_API_KEY=xai-your-api-key-here

# T0 scraping. Both have free tiers.
FIRECRAWL_API_KEY=fc-...
EXA_API_KEY=...

# T0 synthesis defaults to xAI / grok-4.6. Uncomment to borrow any
# OpenAI-compatible gateway instead — delete both lines to put Grok back.
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.6

# X scrape provider for POST /scrape/x (x-scraper | social-signals | fixture)
# X_SCRAPE_PROVIDER=x-scraper
# X_SCRAPER_ROOT=/home/gregory/x-scraper
# X_SCRAPER_PYTHON=/home/gregory/x-scraper/.venv/bin/python
# X_SCRAPE_FIXTURE=data/signals_openclaw_x.json

# T1 scraping, via the social-signals service. Optional: with no scraper
# reachable the run falls back to the recorded signals in scraping/data/ and
# says so. Not checked at startup for that reason.
# SOCIAL_SIGNALS_URL=http://127.0.0.1:8899
# SOCIAL_SIGNALS_API_KEY=demo-key
