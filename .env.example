# Copy this file to .env and fill in the keys.

# xAI. Shared with models/grok.py, which reads XAI_API_KEY directly.
XAI_API_KEY=xai-your-api-key-here

# T0 scraping. Both have free tiers.
FIRECRAWL_API_KEY=fc-...
EXA_API_KEY=...

# T0 synthesis defaults to xAI / grok-4.6. Uncomment to borrow any
# OpenAI-compatible gateway instead — delete both lines to put Grok back.
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.6
