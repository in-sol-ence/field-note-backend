            "description": "True when posts came from a live scrape. False means the scraper was unreachable and fixtures were substituted.",
            "title": "Live",
            "type": "boolean"
          },
          "source_note": {
            "title": "Source Note",
            "type": "string"
          },
          "mapping_errors": {
            "items": {
              "type": "string"
            },
            "title": "Mapping Errors",
            "type": "array"
          }
        },
        "required": [
          "targets",
          "live",
          "source_note"
