            "title": "Comments",
            "type": "array"
          },
          "scraped_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Scraped At"
          },
          "search_query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Search Query"
          },
          "language": {
            "default": "en",
            "title": "Language",
            "type": "string"
          },
          "relevance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Relevance"
          }
        },
        "required": [
          "id",
          "source",
          "url"
