            "$ref": "#/components/schemas/Vocabulary"
          },
          "disambiguation": {
            "$ref": "#/components/schemas/Disambiguation"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        },
        "required": [
          "identity",
          "what",
          "vocabulary",
          "disambiguation",
          "provenance"
        ],
        "title": "ProductDossier",
        "type": "object"
      },
      "Provenance": {
        "properties": {
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
