            "title": "Sources",
            "type": "array"
          },
          "field_confidence": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Field Confidence",
            "type": "object"
          },
          "degraded_sources": {
            "items": {
              "type": "string"
            },
            "title": "Degraded Sources",
            "type": "array"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "runtime_ms": {
            "title": "Runtime Ms",
            "type": "integer"
          }
        },
        "required": [
          "generated_at",
          "runtime_ms"
        ],
        "title": "Provenance",
        "type": "object"
      },
      "RedditTargets": {
        "description": "Where on Reddit this product is actually discussed.\n\nSubreddits alone miss most of it: in the reference scrape, 12 of 27 Reddit\nsignals came from site-wide search, in subreddits nobody would have listed\nup front. So queries carry at least as much weight as subreddits.",
        "properties": {
          "subreddits": {
            "items": {
              "type": "string"
            },
            "title": "Subreddits",
            "type": "array"
          },
          "search_queries": {
            "items": {
              "type": "string"
            },
            "title": "Search Queries",
            "type": "array"
          }
        },
        "title": "RedditTargets",
        "type": "object"
      },
      "ResultEvent": {
        "description": "Terminal event. Always last, always exactly one.",
        "properties": {
          "event": {
            "const": "result",
            "default": "result",
            "title": "Event",
            "type": "string"
          },
          "note": {
            "$ref": "#/components/schemas/FieldNote"
          }
        },
        "required": [
          "note"
        ],
        "title": "ResultEvent",
        "type": "object"
      },
      "ScrapeTargets": {
        "description": "T1's output: what to scrape, derived from the dossier's discriminator.",
        "properties": {
          "reddit": {
            "$ref": "#/components/schemas/RedditTargets"
          },
          "hackernews": {
            "$ref": "#/components/schemas/HackerNewsTargets"
          },
          "rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Why these targets, in one or two sentences. Shown to the operator so a bad expansion is visible before budget is spent.",
            "title": "Rationale"
          }
        },
        "title": "ScrapeTargets",
        "type": "object"
      },
      "Source": {
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          },
          "fetched_at": {
            "format": "date-time",
            "title": "Fetched At",
            "type": "string"
          },
          "via": {
            "enum": [
              "firecrawl",
              "exa",
              "http"
            ],
            "title": "Via",
            "type": "string"
          }
        },
        "required": [
          "url",
          "fetched_at",
          "via"
        ],
        "title": "Source",
        "type": "object"
      },
      "StageEvent": {
        "properties": {
          "event": {
            "const": "stage",
            "default": "stage",
            "title": "Event",
            "type": "string"
          },
          "stage": {
            "enum": [
              "map",
              "scrape_site",
              "scrape_repo",
              "search_collisions",
              "find_similar",
              "search_context",
              "synthesize",
              "select_sources",
              "scrape_reddit",
              "scrape_hackernews",
              "map_posts",
              "extract_issues",
              "build_report"
            ],
            "title": "Stage",
            "type": "string"
          },
          "status": {
            "enum": [
              "running",
              "done",
              "failed"
            ],
            "title": "Status",
            "type": "string"
