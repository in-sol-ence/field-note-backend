      "Disambiguation": {
        "description": "Draft plus the score we compute ourselves rather than ask for.",
        "properties": {
          "name_collisions": {
            "items": {
              "$ref": "#/components/schemas/NameCollision"
            },
            "title": "Name Collisions",
            "type": "array"
          },
          "positive_signals": {
            "items": {
              "type": "string"
            },
            "title": "Positive Signals",
            "type": "array"
          },
          "negative_signals": {
            "items": {
              "type": "string"
            },
            "title": "Negative Signals",
            "type": "array"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Notes"
          },
          "ambiguity_score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Ambiguity Score",
            "type": "number"
          }
        },
        "required": [
          "ambiguity_score"
        ],
        "title": "Disambiguation",
        "type": "object"
      },
      "DossierEvent": {
        "description": "T0 landed. Emitted before T1 starts so the CLI can render it during the\nminutes the scrape takes, rather than holding a finished dossier back.",
        "properties": {
          "event": {
            "const": "dossier",
            "default": "dossier",
            "title": "Event",
            "type": "string"
          },
          "dossier": {
            "$ref": "#/components/schemas/ProductDossier"
          }
        },
        "required": [
          "dossier"
        ],
        "title": "DossierEvent",
        "type": "object"
      },
      "ErrorEvent": {
        "properties": {
          "event": {
            "const": "error",
            "default": "error",
            "title": "Event",
            "type": "string"
          },
          "stage": {
            "anyOf": [
              {
                "enum": [
                  "map",
                  "scrape_site",
                  "scrape_repo",
                  "search_collisions",
                  "find_similar",
                  "search_context",
                  "synthesize",
                  "select_sources",
                  "scrape_reddit",
                  "scrape_hackernews",
                  "map_posts",
                  "extract_issues",
                  "build_report"
