            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "registry",
          "name"
        ],
        "title": "PackageRef",
        "type": "object"
      },
      "Post": {
        "description": "One scraped discussion, normalized across platforms by scraping/mapper.py.\n\nThis is the frozen contract T2 consumes. Field names match mapper.py's\noutput exactly \u2014 it is the producer, this is the schema for what it makes.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "source": {
            "enum": [
              "reddit",
              "x",
              "hackernews",
              "github"
            ],
            "title": "Source",
            "type": "string"
          },
          "source_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Id"
          },
          "url": {
            "title": "Url",
            "type": "string"
          },
          "channel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Channel"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          },
          "body": {
            "default": "",
            "title": "Body",
            "type": "string"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Author"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Created At"
          },
          "created_at_is_scrape_time": {
            "default": false,
            "title": "Created At Is Scrape Time",
            "type": "boolean"
          },
          "score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Score"
          },
          "num_comments": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
