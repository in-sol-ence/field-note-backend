      "NameCollision": {
        "description": "Something else that shares this product's name. Observed, never recalled.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "what_it_is": {
            "title": "What It Is",
            "type": "string"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Domain"
          },
          "why_confusable": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Why Confusable"
          },
          "evidence_url": {
            "title": "Evidence Url",
            "type": "string"
          }
        },
        "required": [
          "name",
          "what_it_is",
          "evidence_url"
