                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stage"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "fatal": {
            "default": false,
            "title": "Fatal",
            "type": "boolean"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorEvent",
        "type": "object"
      },
      "FieldNote": {
        "description": "Everything the run produced. Grows a field per stage as T3-T5 land.",
        "properties": {
          "dossier": {
            "$ref": "#/components/schemas/ProductDossier"
          },
          "harvest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Harvest"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "report": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Report"
          }
        },
        "required": [
          "dossier"
        ],
        "title": "FieldNote",
        "type": "object"
      },
      "HackerNewsTargets": {
        "properties": {
          "search_queries": {
            "items": {
              "type": "string"
            },
            "title": "Search Queries",
            "type": "array"
          }
        },
        "title": "HackerNewsTargets",
        "type": "object"
      },
      "Harvest": {
        "description": "T1's result: the targets chosen, and what came back from them.",
        "properties": {
          "targets": {
            "$ref": "#/components/schemas/ScrapeTargets"
          },
          "posts": {
            "items": {
              "$ref": "#/components/schemas/Post"
