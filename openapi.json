        "title": "Harvest",
        "type": "object"
      },
      "HarvestEvent": {
        "properties": {
          "event": {
            "const": "harvest",
            "default": "harvest",
            "title": "Event",
            "type": "string"
          },
          "harvest": {
            "$ref": "#/components/schemas/Harvest"
          }
        },
        "required": [
          "harvest"
        ],
        "title": "HarvestEvent",
        "type": "object"
      },
      "HeartbeatEvent": {
        "description": "Keeps the connection and the UI alive across a multi-minute scrape.",
        "properties": {
          "event": {
            "const": "heartbeat",
            "default": "heartbeat",
            "title": "Event",
            "type": "string"
          },
          "elapsed_ms": {
            "title": "Elapsed Ms",
            "type": "integer"
          }
        },
        "required": [
          "elapsed_ms"
        ],
        "title": "HeartbeatEvent",
        "type": "object"
      },
      "Identity": {
        "properties": {
          "canonical_name": {
            "title": "Canonical Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "title": "Aliases",
            "type": "array"
          },
          "tagline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Tagline"
          },
          "homepage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Homepage"
          },
          "repo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Repo"
          },
          "docs_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Docs Url"
          },
          "package_names": {
            "items": {
              "$ref": "#/components/schemas/PackageRef"
            },
            "title": "Package Names",
            "type": "array"
          },
          "cli_commands": {
            "items": {
              "type": "string"
            },
            "title": "Cli Commands",
            "type": "array"
          },
          "org_or_owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Org Or Owner"
          },
          "official_accounts": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Official Accounts",
            "type": "object"
          }
        },
        "required": [
          "canonical_name",
          "slug"
