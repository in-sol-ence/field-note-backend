        "type": "object"
      },
      "PostComment": {
        "properties": {
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Author"
          },
          "body": {
            "title": "Body",
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Score"
          },
          "depth": {
            "default": 0,
            "title": "Depth",
            "type": "integer"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Url"
          },
          "is_op": {
            "default": false,
            "title": "Is Op",
            "type": "boolean"
          }
        },
        "required": [
          "body"
        ],
        "title": "PostComment",
        "type": "object"
      },
      "ProductDossier": {
        "properties": {
          "identity": {
            "$ref": "#/components/schemas/Identity"
