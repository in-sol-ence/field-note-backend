          },
          "subcategory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Subcategory"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "primary_use_cases": {
            "items": {
              "type": "string"
            },
            "title": "Primary Use Cases",
            "type": "array"
          },
          "target_users": {
            "items": {
              "type": "string"
            },
            "title": "Target Users",
            "type": "array"
          },
          "key_features": {
            "items": {
              "type": "string"
            },
            "title": "Key Features",
            "type": "array"
          },
          "tech_stack": {
            "items": {
              "type": "string"
            },
            "title": "Tech Stack",
            "type": "array"
          },
          "pricing_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pricing Model"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "License"
          },
          "maturity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
